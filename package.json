{
  "name": "fintrace-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "coreApiVersion": "0.0.7",
  "scripts": {
    "generate:api": "node scripts/generate-api.ts",
    "generate:messages": "node scripts/generate-messages.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:bundle-limits": "node scripts/check-bundle-limits.ts",
    "check:first-paint": "playwright test",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "i18next": "^26.5.12",
    "lucide-react": "^1.59.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-cookie-consent": "^10.0.2",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.9",
    "react-router": "^8.4.0",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  }
